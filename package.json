{
  "name": "swapline",
  "productName": "Swapline",
  "version": "0.2.0",
  "description": "Messenger-artige Oberfläche für Claude Code mit Kontowechsel",
  "main": "src/main.js",
  "author": "ARFEP – IT-Service",
  "scripts": {
    "start": "electron .",
    "licenses": "node tools/collect-licenses.js",
    "dist": "node tools/collect-licenses.js && electron-builder --win && node tools/check-bundle.js"
  },
  "build": {
    "appId": "de.arfep.swapline",
    "productName": "Swapline",
    "copyright": "Copyright (c) 2026 Halil Ayberk Bulut (ARFEP IT-Service) and Swapline contributors",
    "files": [
      "src/**/*",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/swapline.ico"
    },
    "artifactName": "${productName}-${version}-windows.${ext}",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "artifactName": "SWAP-Installer.exe",
      "installerIcon": "src/renderer/assets/swapline.ico",
      "uninstallerIcon": "src/renderer/assets/swapline.ico",
      "shortcutName": "Swapline",
      "uninstallDisplayName": "Swapline",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "packElevateHelper": false
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "homepage": "https://arfep.de/"
}
