{
  "name": "switchdesk",
  "productName": "Switchdesk",
  "version": "0.1.0",
  "description": "Messenger-artige Oberfläche für Claude Code mit Kontowechsel",
  "main": "src/main.js",
  "author": "ARFEP - IT Service",
  "scripts": {
    "start": "electron .",
    "licenses": "node tools/collect-licenses.js",
    "dist": "node tools/collect-licenses.js && electron-builder --win zip && node tools/check-bundle.js",
    "icon": "python tools/make_icon.py"
  },
  "build": {
    "appId": "de.arfep.switchdesk",
    "productName": "Switchdesk",
    "copyright": "Copyright (c) 2026 Halil Ayberk Bulut (ARFEP IT-Service) and Switchdesk contributors",
    "files": [
      "src/**/*",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "${productName}-${version}-windows.${ext}",
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "homepage": "https://arfep.de/"
}
