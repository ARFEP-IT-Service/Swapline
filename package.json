{
  "name": "consoleai",
  "productName": "ConsoleAI",
  "version": "0.1.0",
  "description": "Messenger-artige Oberfläche für Claude Code mit Kontowechsel",
  "main": "src/main.js",
  "author": "ARFEP - IT Service",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "icon": "python tools/make_icon.py"
  },
  "build": {
    "appId": "de.arfep.consoleai",
    "productName": "ConsoleAI",
    "files": [
      "src/**/*",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ConsoleAI.exe"
    },
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      "LICENSE"
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "homepage": "https://arfep.de/"
}
